# AutoCon6 AI Workshop — Environment Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored — your real keys never leave your machine.

# OpenAI API key
# Get one from: https://platform.openai.com/api-keys
# (Workshop attendees: bring your own with $5 credit recommended)
OPENAI_API_KEY=

# Arize AX credentials (used in Lab 5 — Evaluation)
# Sign up free at https://app.arize.com, then copy both values
# from Space Settings.
ARIZE_SPACE_ID=
ARIZE_API_KEY=
